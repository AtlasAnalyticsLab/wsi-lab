{
  "schema_version": 2,
  "name": "wsi_lab_histogym_camelyon16_longrun_efficiency",
  "inherits_scientific_rules_from": {
    "path": "../harness/benchmarks/histogym_comparison/protocol.json",
    "sha256": "965bee4f631d0c5526ce294e48d0b92e7eb7eeb230c9aae4a65300919e4bee84"
  },
  "manifest": {
    "path": "cohort.json",
    "sha256": "d0f881c60335ef4a9fb528ba1a101617843fd19091b3f1023a89b68086d93c0e",
    "cohort_key": "slides",
    "expected_slides": 100
  },
  "source_identity": {
    "histogym": {
      "kind": "git-commit",
      "revision": "5b742760321d28a469d2ef9494e886a49d0aa7f7"
    }
  },
  "rollout": {
    "accepted_steps_per_episode": 100,
    "abstract_action_codes": {
      "P": "pan",
      "I": "zoom_in",
      "O": "zoom_out"
    },
    "abstract_quotas": {
      "pan": 50,
      "zoom_in": 25,
      "zoom_out": 25
    },
    "action_priority_seed": 1,
    "action_priority_algorithm": "For episode index i, Python random.Random(1 + i).shuffle over the quota multiset in pan, zoom_in, zoom_out insertion order",
    "require_distinct_priority_order_per_episode_within_scenario": true,
    "count_only_state_changes": true,
    "excluded_actions": [
      "diagnosis",
      "stay"
    ],
    "unavailable_class_policy": "postpone and select the next pending viable class",
    "unexpected_no_op_policy": "record and retry another valid concrete action; fail on scheduler deadlock",
    "render": false
  },
  "scenarios": {
    "balanced_random_10k": {
      "episode_count": 10000,
      "schedule_kind": "balanced_random",
      "schedule_seed": 1,
      "episodes_per_slide": 100,
      "single_slide_id": null,
      "checkpoints": [
        1,
        10,
        50,
        100,
        500,
        1000,
        5000,
        10000
      ]
    }
  },
  "online_repetitions": 1,
  "native_lifecycle": {
    "wsi_lab": "one environment per scenario; select the planned slide at reset",
    "histogym": "one active slide-bound environment; reset for the same slide and close/reconstruct at each planned slide change"
  },
  "observation_exclusions": {
    "belief_model": false,
    "wsi_lab_constant_belief_value": 0.5,
    "online_embedding_reads": false,
    "policy": false,
    "diagnosis": false,
    "render": false
  },
  "measurement": {
    "attempt_capacity_per_episode": 102,
    "trace_serialization": "compressed NumPy sidecar after resource monitoring stops",
    "checkpoint_writes_during_measurement": false,
    "checkpoint_wall_definition": "one cumulative online timer starting before the first environment construction and ending after the last environment close; checkpoint prefixes include work actually completed by that boundary",
    "preparation_and_import_are_separate_components": true,
    "storage_is_sampled_post_run_and_attached_to_every_checkpoint": true
  },
  "execution": {
    "backend_order": [
      "wsi_lab",
      "histogym"
    ],
    "scenario_order": [
      "balanced_random_10k"
    ],
    "concurrent_backends": false,
    "reuse_preexisting_generated_artifacts": false,
    "reuse_between_scenarios": false,
    "wsi_lab_preparation_device": "configured at runtime",
    "cache_drop_boundaries": [
      "before_wsi_lab_balanced_random_10k",
      "before_histogym_balanced_random_10k"
    ],
    "cache_drop_command": "sync; echo 3 | sudo tee /proc/sys/vm/drop_caches >/dev/null",
    "cache_drop_is_operator_run": true
  },
  "tissue_metric": {
    "performed_post_hoc": true,
    "included_in_timing_or_native_storage": false,
    "thresholds": [
      0.0,
      0.01,
      0.1,
      0.5
    ],
    "wsi_lab_any_overlap_is_a_construction_check": true
  }
}
