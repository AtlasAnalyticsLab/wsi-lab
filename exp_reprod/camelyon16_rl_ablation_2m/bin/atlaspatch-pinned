#!/usr/bin/env python3
"""Run AtlasPatch 1.1.0 with the study's immutable tissue-model snapshot."""

from __future__ import annotations

import hashlib
import os
import sys
import tempfile
from pathlib import Path
from typing import Any

sys.dont_write_bytecode = True

REPOSITORY = "AtlasAnalyticsLab/AtlasPatch"
FILENAME = "model.pth"
SNAPSHOT = "c50a4e86a140c02234897f72f2f4385adb08de50"
SHA256 = "51481c42c1079738f8c506f4da6183002aa34b1eb27d79423ae8f802e052be22"
SIZE = 156_281_205


def _sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as stream:
        for chunk in iter(lambda: stream.read(8 * 1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def _bind_default_revision(checkpoint: Path) -> None:
    """Make the parent process's provenance lookup resolve the pinned file."""

    if checkpoint.parent.name != SNAPSHOT or checkpoint.parent.parent.name != "snapshots":
        raise RuntimeError("pinned AtlasPatch download has an unexpected cache layout")
    repository_cache = checkpoint.parents[2]
    reference = repository_cache / "refs" / "main"
    reference.parent.mkdir(parents=True, exist_ok=True)
    descriptor, temporary = tempfile.mkstemp(prefix=".main.", dir=reference.parent)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as stream:
            stream.write(SNAPSHOT)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, reference)
    except BaseException:
        Path(temporary).unlink(missing_ok=True)
        raise


def _install_download_guard() -> None:
    import atlas_patch.services.segmentation as segmentation

    original = segmentation.hf_hub_download

    def pinned_download(*args: Any, **kwargs: Any) -> str:
        repository = kwargs.get("repo_id", args[0] if args else None)
        filename = kwargs.get("filename", args[1] if len(args) > 1 else None)
        if repository != REPOSITORY or filename != FILENAME:
            return str(original(*args, **kwargs))
        if len(args) > 4:
            raise RuntimeError("AtlasPatch supplied an unsupported positional model revision")
        requested = kwargs.get("revision")
        if requested not in (None, SNAPSHOT):
            raise RuntimeError("AtlasPatch requested a different tissue-model revision")
        guarded = dict(kwargs)
        guarded["revision"] = SNAPSHOT
        checkpoint = Path(original(*args, **guarded)).expanduser().absolute()
        if not checkpoint.is_file():
            raise RuntimeError("pinned AtlasPatch tissue model was not downloaded")
        if checkpoint.stat().st_size != SIZE or _sha256(checkpoint) != SHA256:
            raise RuntimeError("AtlasPatch tissue-model checksum does not match study.json")
        _bind_default_revision(checkpoint)
        return str(checkpoint)

    segmentation.hf_hub_download = pinned_download


def main() -> None:
    _install_download_guard()
    if sys.argv[1:] == ["--prepare-model"]:
        from atlas_patch.services.segmentation import hf_hub_download

        hf_hub_download(repo_id=REPOSITORY, filename=FILENAME)
        print(f"verified AtlasPatch model snapshot={SNAPSHOT} sha256={SHA256}")
        return
    from atlas_patch.cli import main as atlaspatch_main

    atlaspatch_main()


if __name__ == "__main__":
    main()
